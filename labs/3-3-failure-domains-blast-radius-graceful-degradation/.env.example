# Copy to .env and override only the HOST-side ports that conflict
# with your dev box. The in-container ports are fixed by code so the
# rest of the stack keeps working regardless of what you change here.
#
# Workload knobs (RATE, DURATION_S, WARMUP_S) and the five resilience
# toggles (BULKHEAD, CIRCUIT_BREAKER, FALLBACK, RETRY_BUDGET, LOAD_SHED)
# are passed on the `make` command line, NOT through this file. Putting
# them here would silently override the command-line values the topic
# guide tells you to pass, so don't.

LAB_GATEWAY_PORT=8080
LAB_PRICE_PORT=8091
LAB_CART_PORT=8092
LAB_RECOMMENDATIONS_PORT=8093
LAB_REVIEWS_PORT=8094
LAB_RECENTLY_VIEWED_PORT=8095
LAB_LOADGEN_PORT=8090
LAB_FAULT_INJECTOR_PORT=9000
LAB_PROMETHEUS_PORT=9090
LAB_GRAFANA_PORT=3000
