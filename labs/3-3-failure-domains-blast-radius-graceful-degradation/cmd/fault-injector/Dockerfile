# syntax=docker/dockerfile:1.7
# Multi-stage build for fault-injector. go.sum is regenerated by
# `go mod tidy` on first build - we don't ship one.

FROM golang:1.22-alpine AS build
WORKDIR /src
RUN apk add --no-cache git
COPY go.mod ./
RUN go mod download || true
COPY . .
RUN go mod tidy
RUN CGO_ENABLED=0 GOOS=linux GOFLAGS=-mod=mod go build -trimpath -ldflags="-s -w" \
    -o /out/fault-injector ./cmd/fault-injector

FROM alpine:3.20
RUN apk add --no-cache wget ca-certificates && update-ca-certificates
COPY --from=build /out/fault-injector /usr/local/bin/fault-injector
EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/fault-injector"]
