# Copy to .env and override only the HOST-side ports that conflict
# with your dev box. The in-container ports are fixed by code so the
# rest of the stack keeps working regardless of what you change here.
#
# Workload knobs (DIST, RUNS, DURATION, TTL, HOT_RATE, WEIGHT, ...) and
# the cache-pattern toggles are passed on the `make` command line, NOT
# through this file. Putting them here would silently override the
# command-line values the topic guide tells you to pass, so don't.

LAB_APP_PORT=8080
LAB_LOADGEN_PORT=8090
LAB_POSTGRES_PORT=15432
LAB_REDIS_1_PORT=16391
LAB_REDIS_2_PORT=16392
LAB_REDIS_3_PORT=16393
LAB_PROMETHEUS_PORT=9090
LAB_GRAFANA_PORT=3000
