# Copy to .env and override only the HOST-side ports that conflict
# with your dev box. The in-container ports are fixed by code so the
# rest of the stack keeps working regardless of what you change here.
#
# Workload knobs (RATE, DURATION, RUNS, COUNT, TRANSIENT_RATE,
# PERMANENT_RATE, MAX_RETRIES, CANDIDATE) are passed on the `make`
# command line, NOT through this file. Putting them here would silently
# override the command-line values the topic guide tells you to pass.

LAB_PRODUCER_PORT=8080
LAB_LOADGEN_PORT=8090
LAB_CONSUMER1_PORT=8101
LAB_CONSUMER2_PORT=8102
LAB_CONSUMER3_PORT=8103
LAB_RABBITMQ_PORT=5672
LAB_RABBITMQ_MGMT_PORT=15672
LAB_REDPANDA_KAFKA_PORT=9092
LAB_REDPANDA_ADMIN_PORT=9644
LAB_POSTGRES_PORT=5432
LAB_PROMETHEUS_PORT=9090
LAB_GRAFANA_PORT=3000

# Broker topology bound. The work queue is declared with this
# x-max-length + x-overflow=reject-publish so step 6's sustained 2x
# overload can exercise broker-level backpressure. Large enough that
# baseline / poison / fault runs never hit it.
LAB_QUEUE_MAX_LEN=50000
