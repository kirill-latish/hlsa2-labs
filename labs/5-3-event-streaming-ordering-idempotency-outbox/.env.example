# Copy to .env and override only the HOST-side ports that conflict with
# your dev box. In-container ports are fixed by code so the rest of the
# stack keeps working regardless of what you change here.
#
# The experiment knobs (KEY=, RATE=, CANDIDATE=, DURATION=, LABEL=) are
# passed on the `make` command line, NOT through this file. The producer
# and consumer modes flip at runtime via their admin endpoints (see
# scripts/apply-fix.sh), so the values below are only host ports plus
# the topic partition count seed reads.

LAB_POSTGRES_PORT=5432
LAB_REDPANDA_KAFKA_PORT=9092
LAB_REDPANDA_ADMIN_PORT=9644
LAB_PRODUCER_PORT=8080
LAB_OUTBOX_RELAY_PORT=9102
LAB_CONSUMER1_PORT=9103
LAB_CONSUMER2_PORT=9113
LAB_CONSUMER3_PORT=9123
LAB_PROMETHEUS_PORT=9090
LAB_GRAFANA_PORT=3000

# Topic partition count created by `make seed`. The ordering experiment
# needs >1 partition for the wrong key to scatter same-entity events.
REDPANDA_PARTITIONS=6
