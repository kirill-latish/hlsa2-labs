# Copy to .env and override only the HOST-side ports that conflict
# with your dev box. The in-container ports are fixed by code so the
# rest of the stack keeps working regardless of what you change here.
#
# Workload knobs (RATE, DURATION, LABEL, ALGO, ...) and the health-check
# tuning are passed on the `make` command line, NOT through this file.
# Putting them here would silently override the command-line values the
# topic guide tells you to pass, so don't.

LAB_EDGE_PORT=8080
LAB_BACKEND1_PORT=8081
LAB_BACKEND2_PORT=8082
LAB_BACKEND3_PORT=8083
LAB_BACKEND4_PORT=8084
LAB_LOADGEN_PORT=8090
LAB_POSTGRES_PORT=5432
LAB_PROMETHEUS_PORT=9090
LAB_GRAFANA_PORT=3000
