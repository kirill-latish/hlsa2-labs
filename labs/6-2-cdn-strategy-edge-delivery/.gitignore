.env

# Per-run artefacts that are noise; keep the run dirs themselves.
perf/results/**/*.log

# Generated screenshots; keep the placeholder for the directory.
docs/img/*.png
docs/img/*.jpg
!docs/img/.gitkeep

# Filled-in review (students copy this from the .template version).
docs/review.md

# Go scratch space
bin/

.DS_Store

# Python bytecode from analyze-*.py imports.
**/__pycache__/
*.pyc
